# --------------------------------
# DATA ANALYSIS
# --------------------------------

def analyze_traffic(df):

    df.columns = (
        df.columns.str.strip()
        .str.lower()
        .str.replace(" ", "_")
    )

    required_columns = [
        "session_id",
        "page",
        "timestamp",
        "duration_seconds",
        "step"
    ]

    for col in required_columns:
        if col not in df.columns:
            raise ValueError("Missing column: " + col)

    # Remove duplicate rows
    df = df.drop_duplicates().copy()

    # Remove missing essential values
    df = df.dropna(subset=required_columns).copy()

    if df.empty:
        raise ValueError("No valid records found.")

    # Clean text
    df["session_id"] = df["session_id"].astype(str).str.strip()
    df["page"] = df["page"].astype(str).str.strip()

    if (df["session_id"] == "").any():
        raise ValueError("Session ID cannot be empty.")

    if (df["page"] == "").any():
        raise ValueError("Page name cannot be empty.")

    # Convert data types
    df["timestamp"] = pd.to_datetime(
        df["timestamp"], errors="coerce"
    )

    df["duration_seconds"] = pd.to_numeric(
        df["duration_seconds"], errors="coerce"
    )

    df["step"] = pd.to_numeric(
        df["step"], errors="coerce"
    )

    df = df.dropna(
        subset=["timestamp", "duration_seconds", "step"]
    ).copy()

    if df.empty:
        raise ValueError("No valid traffic records found.")

    if (df["duration_seconds"] < 0).any():
        raise ValueError("Duration cannot be negative.")

    if (df["step"] < 1).any():
        raise ValueError("Step must be at least 1.")

    df["step"] = df["step"].astype(int)

    # Sort page visits
    df = df.sort_values(
        ["session_id", "timestamp", "step"]
    )

    # Total page views
    page_views = len(df)

    # Total unique sessions
    total_sessions = df["session_id"].nunique()

    # Average session duration
    session_duration = (
        df.groupby("session_id")["duration_seconds"].sum()
    )

    average_duration = round(
        session_duration.mean(), 2
    )

    # Page views
    page_counts = (
        df.groupby("page")
        .size()
        .reset_index(name="views")
        .sort_values("views", ascending=False)
    )

    # Last visited pages
    last_pages = (
        df.groupby("session_id")
        .tail(1)["page"]
        .value_counts()
        .reset_index()
    )

    last_pages.columns = ["page", "dropoffs"]

    # Single-page session rate
    page_count = df.groupby("session_id").size()

    single_page_sessions = int(
        (page_count == 1).sum()
    )

    dropoff_rate = round(
        single_page_sessions / total_sessions * 100, 2
    )

    # User journeys
    journeys = []

    for session, group in df.groupby("session_id"):

        journey = " -> ".join(group["page"].tolist())

        journeys.append({
            "session": session,
            "journey": journey
        })

    return {
        "page_views": page_views,
        "sessions": total_sessions,
        "average_duration": average_duration,
        "dropoff_rate": dropoff_rate,
        "pages": page_counts.to_dict("records"),
        "dropoffs": last_pages.to_dict("records"),
        "journeys": journeys
    }


