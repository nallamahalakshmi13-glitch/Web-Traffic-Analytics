@app.route("/", methods=["GET", "POST"])
def home():

    result = None
    error = None

    if request.method == "POST":

        try:

            file = request.files.get("file")

            if file and file.filename:

                if not file.filename.lower().endswith(".csv"):
                    raise ValueError("Upload only CSV files.")

                df = pd.read_csv(file)

            else:

                df = sample_data.copy()

            result = analyze_traffic(df)

            # Save report for downloading
            report_id = uuid.uuid4().hex

            report_path = os.path.join(
                OUTPUT_FOLDER,
                report_id + ".csv"
            )

            df.to_csv(report_path, index=False)

            # Save report path in application state
            app.config["LATEST_REPORT"] = report_path

        except Exception as e:

            error = str(e)

    return render_template_string(
        HTML,
        result=result,
        error=error
    )


# --------------------------------
# DOWNLOAD REPORT
# --------------------------------

@app.route("/download/traffic_report")
def download_report():

    path = app.config.get("LATEST_REPORT")

    if not path or not os.path.isfile(path):
        return "Please analyze a dataset first.", 404

    return send_file(
        path,
        as_attachment=True,
        download_name="traffic_report.csv"
    )


